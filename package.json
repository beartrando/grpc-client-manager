{
  "name": "@shared/grpc-client-manager",
  "version": "1.0.0",
  "description": "Shared gRPC client manager",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beartrando/grpc-client-manager.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.3",
    "@shared/logger": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist"
  ]
}
